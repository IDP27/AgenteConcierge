{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (Fastify + agente)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@concierge/api", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Web (Next.js)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@concierge/web", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      // Um F5 sobe tudo: Postgres (docker, com --wait) → API → Web.
      // O simulador fica em http://localhost:3000/simulador.
      "name": "Stack completa (Postgres + API + Web)",
      "configurations": ["API (Fastify + agente)", "Web (Next.js)"],
      "preLaunchTask": "Postgres (docker)",
      "stopAll": true
    }
  ]
}
