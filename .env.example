# --- Banco (docker-compose sobe o Postgres nessas credenciais) ---
DATABASE_URL="postgresql://concierge:concierge@localhost:5433/concierge"

# --- API ---
PORT=3333
# Chave do painel admin no MVP (header x-admin-key)
ADMIN_API_KEY="dev-admin-key"

# --- Anthropic (obrigatória a partir da Fase 2 / motor do agente) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3333"

# --- Simulador de WhatsApp (ferramenta de teste em /simulador) ---
# Permite conversar como qualquer hóspede SEM autenticação — por isso fica
# ligado fora de produção e desligado em produção. Só ligue em produção
# (ex.: staging de demonstração) sabendo que é um vetor de personificação.
# SIMULATOR_ENABLED="true"

# --- Canal WhatsApp (Meta Cloud API) — opcional: sem as 4 variáveis o canal fica desligado ---
# Access token do app Meta (System User token de longa duração em produção)
# WHATSAPP_ACCESS_TOKEN=""
# ID do número de telefone (Meta Business > WhatsApp > API Setup)
# WHATSAPP_PHONE_NUMBER_ID=""
# Valor arbitrário que você repete ao cadastrar o webhook no painel da Meta
# WHATSAPP_VERIFY_TOKEN=""
# App Secret (valida a assinatura X-Hub-Signature-256 dos webhooks)
# WHATSAPP_APP_SECRET=""
